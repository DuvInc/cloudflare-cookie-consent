{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cookie-consent-example",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  /*
   * The proof log: one row per DECISION, never per page view.
   *
   * `npm run dev` creates the table in a local database, so trying this out
   * writes nothing anywhere real, and the placeholder id below is fine locally.
   * To deploy, create a database (`npx wrangler d1 create cookie-consent`),
   * paste its id here, and apply the schema once:
   *   npx wrangler d1 migrations apply cookie-consent --remote
   *
   * Remove this block and the engine still works: decisions are honoured and
   * simply not logged.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookie-consent",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],

  /*
   * Optional: caps the proof rows one address can write (30 a minute), shared
   * across isolates. Without it the engine uses an in-isolate counter, so this
   * block can go. Over the limit the visitor still gets the cookie; only the
   * proof row is skipped.
   *
   * `namespace_id` is ACCOUNT-WIDE: two Workers on one Cloudflare account with
   * the same id share one counter. "1001" is a placeholder: pick your own, an id
   * no other Worker of your account uses.
   */
  "ratelimits": [
    { "name": "CONSENT_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Misses fall through to ASSETS.fetch(), which returns 404.html. That page
    // carries the same layout and so the same trackers: it has to stay consentable.
    "not_found_handling": "404-page",
    /*
     * EVERY document, and only documents: everything, minus the assets.
     *
     * Listing the pages one by one is the trap. A page missing from the list
     * never reaches the Worker, so it ships its trackers with no banner and
     * nothing says so. The two failure modes are not equal: a forgotten
     * exclusion costs one Worker invocation on an asset, a forgotten page costs
     * a tracker without consent.
     *
     * The cost of this setting is one invocation per page view. Assets stay on
     * the unbilled static layer: add an exclusion for each folder of them.
     * `*` matches across slashes.
     */
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
